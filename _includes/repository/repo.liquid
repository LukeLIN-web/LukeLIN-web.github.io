{% assign entry = include.entry %}
{% assign parts = entry.repo | split: '/' %}

<div class="col p-2">
  <div class="card h-100">
    <div class="card-body">
      <h6 class="card-title mb-2">
        <a href="https://github.com/{{ entry.repo }}">
          <span class="text-muted">{{ parts[0] }}/</span>{{ parts[1] }}
        </a>
      </h6>
      {% if entry.description %}
        <p class="card-text text-muted mb-2">{{ entry.description }}</p>
      {% endif %}
      <p class="card-text mb-0">
        <img
          alt="Stars"
          src="https://img.shields.io/github/stars/{{ entry.repo }}?style=flat-square&logo=github&label=stars&color=555555"
        >
        <img
          alt="Forks"
          src="https://img.shields.io/github/forks/{{ entry.repo }}?style=flat-square&logo=github&label=forks&color=555555"
        >
        <img
          alt="Language"
          src="https://img.shields.io/github/languages/top/{{ entry.repo }}?style=flat-square&color=555555"
        >
        <img
          alt="Last commit"
          src="https://img.shields.io/github/last-commit/{{ entry.repo }}?style=flat-square&color=555555"
        >
      </p>
    </div>
    {% if entry.homepage %}
      <div class="card-footer bg-transparent">
        <a class="card-link" href="{{ entry.homepage }}">{{ entry.homepage | remove: 'https://' | remove_first: 'www.' }}</a>
      </div>
    {% endif %}
  </div>
</div>
