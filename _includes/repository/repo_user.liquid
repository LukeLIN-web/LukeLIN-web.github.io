<div class="card w-100 mb-3">
  <div class="card-body d-flex flex-column flex-sm-row align-items-center text-center text-sm-left">
    <img
      class="rounded-circle mr-sm-4 mb-3 mb-sm-0"
      width="80"
      height="80"
      loading="lazy"
      alt="{{ include.username }}"
      src="https://github.com/{{ include.username }}.png?size=160"
    >
    <div>
      <h6 class="card-title mb-2">
        <a href="https://github.com/{{ include.username }}">@{{ include.username }}</a>
      </h6>
      <p class="card-text mb-0">
        <img
          alt="Followers"
          src="https://img.shields.io/github/followers/{{ include.username }}?style=flat-square&logo=github&label=followers&color=555555"
        >
        <img
          alt="Public repositories"
          src="https://img.shields.io/badge/dynamic/json?style=flat-square&logo=github&label=public%20repos&color=555555&query=%24.public_repos&url=https%3A%2F%2Fapi.github.com%2Fusers%2F{{ include.username }}"
        >
      </p>
    </div>
  </div>
</div>
